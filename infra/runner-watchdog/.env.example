# Copy to /opt/runner-watchdog/.env on the Proxmox host, then `chmod 600`.
# NO real secrets in git — this is only a template.

# Read-only GitHub token for the runner-status API (scope: read:org).
GH_TOKEN=ghp_xxx_readonly_actions_org

# Alert recipient.
ALERT_TO=aazad.aahmed@hotmail.com

# msmtp account name configured in /root/.msmtprc (one.com SMTP).
MSMTP_ACCOUNT=onecom

# --- tuning (optional; defaults shown) ---
LXC_ID=104
GH_ORG=ADZA-Group
COOLDOWN_SEC=21600     # 6h between repeat down-alerts
ZERO_TICKS_DOWN=2      # consecutive 0-runner ticks before declaring down
RESTART_WAIT=60
REBOOT_WAIT=90
