# Copy to /opt/runner-prewarmer/.env on the Proxmox host, then `chmod 600`.
# NO real secrets in git — template only. The same read-only billing token the
# watchdog uses works here (scope: read:org).
GH_TOKEN=ghp_xxx_readonly_actions_org

# --- tuning (defaults shown) ---
LXC_ID=104
GH_ORG=ADZA-Group
INCLUDED_MINUTES=2000
PREWARM_THRESHOLD=400     # remain <= this -> keep PREWARM_COUNT runners warm
PREWARM_COUNT=3
